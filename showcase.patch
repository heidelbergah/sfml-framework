+++ b/examples/showcase/ShaderScene.hpp
@@ -0,0 +1,69 @@
+/**
+ * ShaderScene.hpp  -  Showcase
+ *
+ * A small desktop of shader windows. Each window is a Frame with a
+ * ShaderView inside, running one effect; the dock along the bottom opens
+ * them, and they can be dragged, raised and closed.
+ *
+ * Input goes only to the window under the cursor, the front-most one,
+ * found with WidgetManager::widget_at, so each effect behaves like a
+ * self-contained program. A window being dragged keeps the mouse until
+ * the button is released, even if the cursor slips off it.
+ */
+
+#ifndef SHOWCASE_SHADER_SCENE_HPP
+#define SHOWCASE_SHADER_SCENE_HPP
+
+#include "DemoScene.hpp"
+#include "Effects.hpp"
+
+#include <map>
+
+namespace showcase
+{
+
+class ShaderScene : public DemoScene
+{
+private:
+    struct Window
+    {
+        std::unique_ptr<HintedEffect> effect;
+        std::shared_ptr<Frame>        frame;
+        std::shared_ptr<ShaderView>   view;
+        std::shared_ptr<Button>       dock_button;
+        sf::Vector2f                  home;
+    };
+
+    // Key order is dock order.
+    std::vector<std::string>      m_order;
+    std::map<std::string, Window> m_windows;
+
+    WidgetManager          m_desktop;     // open windows, front-most last
+    std::shared_ptr<Frame> m_captured;    // owns the mouse while a button is held
+    std::shared_ptr<Frame> m_hovered;
+
+    std::string m_default_hint;
+
+    void add_window(const std::string& key, std::unique_ptr<HintedEffect> effect,
+                    sf::Vector2f home);
+    void open(const std::string& key);
+    void close(const std::string& key);
+    void refresh_dock();
+    void set_hovered(const std::shared_ptr<Frame>& frame);
+
+    [[nodiscard]] Window* find(const std::shared_ptr<Widget>& frame);
+
+public:
+    ShaderScene();
+
+    void on_enter() override;
+    void on_exit() override;
+    void begin_frame() override;
+    void handle_event(const sf::Event& event, sf::Vector2f mouse_pos) override;
+    void update(sf::Time delta_time) override;
+    void render(sf::RenderTarget& target) override;
+};
+
+}
+
+#endif
diff --git a/examples/showcase/ShaderView.cpp b/examples/showcase/ShaderView.cpp
new file mode 100644
index 0000000..3f496c4
--- /dev/null
+++ b/examples/showcase/ShaderView.cpp
@@ -0,0 +1,117 @@
+/**
+ * ShaderView.cpp  -  Showcase
+ */
+
+#include "ShaderView.hpp"
+
+#include "Theme.hpp"
+
+namespace showcase
+{
+
+ShaderView::ShaderView(Effect& effect, ShaderManager& shaders)
+    : Widget(sf::Vector2f(effect.size())), m_effect(&effect)
+{
+    set_transition(TransitionFunction::None);
+
+    if(!sf::Shader::isAvailable())
+        m_failure = "shaders are not\nsupported here";
+    else if(!m_target.resize(effect.size()))
+        m_failure = "could not create\na render texture";
+    else if(!effect.load(shaders))
+        m_failure = "shader failed\nto load";
+    else
+        m_ready = true;
+
+    m_target.setSmooth(false);
+}
+
+void ShaderView::begin_frame()
+{
+    m_pointer.pressed = false;
+}
+
+void ShaderView::update(sf::Time delta_time)
+{
+    if(!m_ready)
+    {
+        // Still draw something, so a broken shader is a message in a
+        // window rather than an empty hole.
+        if(m_target.getSize().x == 0) return;
+
+        m_target.clear(INK);
+        sf::Text text(*font(), m_failure, TEXT_SIZE);
+        text.setFillColor(TEXT_DIM);
+        text.setPosition({10.0f, 8.0f});
+        m_target.draw(text);
+        m_target.display();
+        return;
+    }
+
+    m_effect->update(delta_time.asSeconds(), m_pointer);
+
+    m_target.setView(m_target.getDefaultView());
+    m_target.clear(INK);
+    m_effect->render(m_target);
+    m_target.display();
+}
+
+void ShaderView::handle_event(const sf::Event& event, sf::Vector2f mouse_pos)
+{
+    // mouse_pos is in the window's local space; ours starts at our own
+    // position inside it.
+    sf::Vector2f const local = mouse_pos - floor_vector(get_position());
+
+    if(event.is<sf::Event::MouseMoved>())
+    {
+        m_pointer.pos    = local;
+        m_pointer.inside = contains(mouse_pos);
+    }
+    else if(const auto* pressed = event.getIf<sf::Event::MouseButtonPressed>())
+    {
+        m_pointer.pos    = local;
+        m_pointer.inside = contains(mouse_pos);
+        if(pressed->button == sf::Mouse::Button::Left && m_pointer.inside)
+        {
+            m_pointer.down    = true;
+            m_pointer.pressed = true;
+        }
+    }
+    else if(const auto* released = event.getIf<sf::Event::MouseButtonReleased>())
+    {
+        if(released->button == sf::Mouse::Button::Left) m_pointer.down = false;
+    }
+}
+
+void ShaderView::on_draw(sf::RenderTarget& target, sf::RenderStates states) const
+{
+    sf::Sprite sprite(m_target.getTexture());
+    target.draw(sprite, states);
+}
+
+void draw_quad(sf::RenderTarget& target, sf::Vector2u size, const sf::Shader* shader)
+{
+    float const w = static_cast<float>(size.x);
+    float const h = static_cast<float>(size.y);
+
+    sf::Vertex const quad[] = {
+        {{0.0f, 0.0f}, sf::Color::White, {0.0f, 0.0f}},
+        {{w,    0.0f}, sf::Color::White, {1.0f, 0.0f}},
+        {{0.0f, h},    sf::Color::White, {0.0f, 1.0f}},
+        {{w,    h},    sf::Color::White, {1.0f, 1.0f}},
+    };
+
+    sf::RenderStates states;
+    states.shader = shader;
+    target.draw(quad, 4, sf::PrimitiveType::TriangleStrip, states);
+}
+
+void set_ramp(sf::Shader& shader, sf::Color c0, sf::Color c1, sf::Color c2, sf::Color c3)
+{
+    shader.setUniform("c0", sf::Glsl::Vec4(c0));
+    shader.setUniform("c1", sf::Glsl::Vec4(c1));
+    shader.setUniform("c2", sf::Glsl::Vec4(c2));
+    shader.setUniform("c3", sf::Glsl::Vec4(c3));
+}
+
+}
diff --git a/examples/showcase/ShaderView.hpp b/examples/showcase/ShaderView.hpp
new file mode 100644
index 0000000..c162b29
--- /dev/null
+++ b/examples/showcase/ShaderView.hpp
@@ -0,0 +1,110 @@
+/**
+ * ShaderView.hpp  -  Showcase
+ *
+ * A widget that owns a small render texture and lets an Effect draw
+ * into it every frame. Put one inside a Frame and you have a window
+ * running its own shader scene.
+ *
+ * Rendering into a texture of its own is what keeps each window self
+ * contained: an effect cannot draw outside its rectangle (Frame does
+ * not clip children), and several can run side by side.
+ *
+ * Input arrives the ordinary widget way, through the Frame's
+ * handle_event, so an effect only ever sees the mouse when its window
+ * is the one being routed to.
+ */
+
+#ifndef SHOWCASE_SHADER_VIEW_HPP
+#define SHOWCASE_SHADER_VIEW_HPP
+
+#include "../../include/framework/ShaderManager.hpp"
+#include "../../include/gui/Frame.hpp"
+#include "../../include/gui/Widget.hpp"
+
+namespace showcase
+{
+
+/*
+ * The mouse, as one effect sees it. Coordinates are local to the view,
+ * in view pixels, with (0, 0) at the top left.
+ */
+struct Pointer
+{
+    sf::Vector2f pos;
+    bool inside{false};    // over this view, and this view's window has the mouse
+    bool down{false};      // left button held after pressing inside
+    bool pressed{false};   // left button went down inside since the last update
+};
+
+class Effect
+{
+public:
+    virtual ~Effect() = default;
+
+    [[nodiscard]] virtual std::string  title() const = 0;
+    [[nodiscard]] virtual sf::Vector2u size() const = 0;
+
+    /*
+     * Loads shaders and allocates targets. Return false if anything is
+     * missing; the view then shows a short message instead.
+     */
+    virtual bool load(ShaderManager& shaders) = 0;
+
+    virtual void update(float dt, const Pointer& pointer) = 0;
+
+    /*
+     * Draw the effect. `target` is size() pixels and already cleared.
+     */
+    virtual void render(sf::RenderTarget& target) = 0;
+
+    /*
+     * Optional controls below the view. The window is sized from
+     * controls_height(), then build_controls() adds them into it with
+     * `origin` at their top-left.
+     */
+    [[nodiscard]] virtual float controls_height() const { return 0.0f; }
+
+    virtual void build_controls(Frame& frame, sf::Vector2f origin)
+    {
+        (void)frame;
+        (void)origin;
+    }
+
+    virtual void on_open()  {}
+    virtual void on_close() {}
+};
+
+class ShaderView : public Widget
+{
+private:
+    Effect*           m_effect{nullptr};   // owned by the scene's window
+    sf::RenderTexture m_target;
+    Pointer           m_pointer;
+    bool              m_ready{false};
+    std::string       m_failure;
+
+    void on_draw(sf::RenderTarget& target, sf::RenderStates states) const override;
+
+public:
+    ShaderView(Effect& effect, ShaderManager& shaders);
+
+    void begin_frame() override;
+    void update(sf::Time delta_time) override;
+    void handle_event(const sf::Event& event, sf::Vector2f mouse_pos) override;
+};
+
+/*
+ * Draws a quad covering `size` pixels with texture coordinates running
+ * 0 to 1, so a fragment shader can read gl_TexCoord[0] as "where am I
+ * in this rectangle" without any texture bound.
+ */
+void draw_quad(sf::RenderTarget& target, sf::Vector2u size, const sf::Shader* shader);
+
+/*
+ * Sets c0..c3, the four-colour ramp every effect quantises to.
+ */
+void set_ramp(sf::Shader& shader, sf::Color c0, sf::Color c1, sf::Color c2, sf::Color c3);
+
+}
+
+#endif
diff --git a/examples/showcase/ShakeScene.cpp b/examples/showcase/ShakeScene.cpp
new file mode 100644
index 0000000..cf8bb6a
--- /dev/null
+++ b/examples/showcase/ShakeScene.cpp
@@ -0,0 +1,342 @@
+/**
+ * ShakeScene.cpp  -  Showcase
+ */
+
+#include "ShakeScene.hpp"
+
+#include <cstdio>
+
+namespace showcase
+{
+
+namespace
+{
+    constexpr float GROUND_Y  = 444.0f;
+    constexpr float MARGIN    = 48.0f;      // world extends past the screen, so shake never shows an edge
+
+    constexpr float PANEL_W   = 280.0f;
+    constexpr float PANEL_H   = 226.0f;
+
+    const sf::Vector2f GRAPH_POS{92.0f, 32.0f};
+    const sf::Vector2f GRAPH_SIZE{176.0f, 64.0f};
+    constexpr std::size_t HISTORY = 176;    // one sample per pixel column
+
+    constexpr float RUMBLE_MIN = 0.10f;
+    constexpr float RUMBLE_MAX = 0.60f;
+
+    const sf::Color SKY_TOP {26, 23, 34};
+    const sf::Color FAR     {36, 33, 46};
+    const sf::Color NEAR    {48, 43, 58};
+    const sf::Color GROUND  {30, 27, 36};
+}
+
+ShakeScene::ShakeScene()
+    : DemoScene("Shake lab", "1 2 3  impulses   hold space  rumble"),
+      m_camera({VIEW_W, VIEW_H}, {VIEW_W / 2.0f, VIEW_H / 2.0f})
+{
+    m_sparks = std::make_shared<ParticleSystem>();
+    m_sparks->set_lifespan(sf::seconds(0.9f));
+    m_sparks->set_gravity(sf::Vector2f{0.0f, 380.0f});
+    m_sparks->set_gravity_enabled(true);
+    m_sparks->set_drag(0.25f);
+    m_sparks->set_fade(true);
+    m_particles.add_particle_system("sparks", m_sparks);
+
+    build_world();
+    build_panel();
+}
+
+void ShakeScene::build_world()
+{
+    m_world.clear();
+    m_roofs.clear();
+
+    float const left  = -MARGIN;
+    float const right = VIEW_W + MARGIN;
+
+    // Night sky, a shade lighter near the horizon.
+    push_rect(m_world, {{left, -MARGIN}, {right - left, GROUND_Y + MARGIN}}, SKY_TOP);
+    push_rect(m_world, {{left, GROUND_Y - 120.0f}, {right - left, 120.0f}},
+              mix(SKY_TOP, FAR, 0.35f));
+
+    // A private, fixed-seed generator: the skyline comes out the same
+    // every run, and the shared Random:: sequence is left alone.
+    std::mt19937 rng{7};
+    auto real = [&rng](float lo, float hi)
+    {
+        return std::uniform_real_distribution<float>{lo, hi}(rng);
+    };
+    auto chance = [&real](float p) { return real(0.0f, 1.0f) < p; };
+
+    // A handful of stars.
+    for(int i = 0; i < 70; ++i)
+    {
+        sf::Vector2f const at{std::floor(real(left, right)),
+                              std::floor(real(-MARGIN, GROUND_Y - 160.0f))};
+        push_rect(m_world, {at, {1.0f, 1.0f}}, fade(TEXT, real(0.15f, 0.5f)));
+    }
+
+    // Two rows of buildings, the far row taller and darker.
+    auto row = [&](sf::Color body, float min_h, float max_h, float min_w, float max_w,
+                   float window_chance, bool record_roofs)
+    {
+        float x = left + real(-20.0f, 0.0f);
+        while(x < right)
+        {
+            float const w = std::floor(real(min_w, max_w));
+            float const h = std::floor(real(min_h, max_h));
+            float const top = GROUND_Y - h;
+
+            push_rect(m_world, {{x, top}, {w, h}}, body);
+
+            // Windows on a 7 x 9 grid, a few of them lit.
+            for(float wy = top + 8.0f; wy < GROUND_Y - 10.0f; wy += 9.0f)
+            {
+                for(float wx = x + 5.0f; wx < x + w - 6.0f; wx += 7.0f)
+                {
+                    if(!chance(window_chance)) continue;
+                    sf::Color const lit = chance(0.75f) ? AMBER : SKY;
+                    push_rect(m_world, {{wx, wy}, {3.0f, 4.0f}},
+                              fade(lit, real(0.35f, 0.8f)));
+                }
+            }
+
+            if(record_roofs) m_roofs.push_back({x, x + w, top});
+            x += w + std::floor(real(2.0f, 14.0f));
+        }
+    };
+
+    row(FAR,  140.0f, 250.0f, 34.0f, 70.0f, 0.06f, false);
+    row(NEAR,  60.0f, 160.0f, 40.0f, 84.0f, 0.12f, true);
+
+    push_rect(m_world, {{left, GROUND_Y}, {right - left, VIEW_H + MARGIN - GROUND_Y}}, GROUND);
+    push_rect(m_world, {{left, GROUND_Y}, {right - left, 1.0f}}, LINE);
+
+    m_moon.setRadius(16.0f);
+    m_moon.setPointCount(24);
+    m_moon.setFillColor(mix(TEXT, INK, 0.25f));
+    m_moon.setPosition({120.0f, 88.0f});
+}
+
+void ShakeScene::build_panel()
+{
+    m_panel = std::make_shared<Frame>(sf::Vector2f{PANEL_W, PANEL_H}, PANEL, *font());
+    m_panel->set_outline(LINE, 1.0f);
+    m_panel->set_transition(TransitionFunction::EaseOutBack);
+    m_panel->set_transition_duration(0.5f);
+    m_widgets.add_widget("panel", m_panel);
+
+    m_gauge_value = make_label({64.0f, 20.0f}, "0.00", TEXT_DIM, Alignment::CENTER);
+    m_gauge_value->set_position({12.0f, 8.0f}, true);
+    m_panel->add_widget("gauge_value", m_gauge_value);
+
+    m_gauge = std::make_shared<Gauge>(sf::Vector2f{64.0f, 64.0f}, AMBER,
+                                      sf::Vector2f{0.0f, 1.0f},
+                                      sf::Vector2f{-120.0f, 120.0f});
+    m_gauge->set_dial_color(PANEL_HI);
+    m_gauge->set_arm_transition(TransitionFunction::EaseOutQuad);
+    m_gauge->set_arm_transition_duration(0.08f);
+    m_gauge->set_transition(TransitionFunction::None);
+    m_gauge->set_position({12.0f, 32.0f}, true);
+    m_gauge->set_value(0.0f, true);
+    m_panel->add_widget("gauge", m_gauge);
+
+    auto legend_a = make_label({80.0f, 20.0f}, "trauma", AMBER);
+    legend_a->set_position({GRAPH_POS.x, 8.0f}, true);
+    m_panel->add_widget("legend_a", legend_a);
+
+    auto legend_b = make_label({80.0f, 20.0f}, "floor", SKY, Alignment::RIGHT);
+    legend_b->set_position({GRAPH_POS.x + GRAPH_SIZE.x - 80.0f, 8.0f}, true);
+    m_panel->add_widget("legend_b", legend_b);
+
+    struct Impulse { const char* name; float amount; int sparks; };
+    Impulse const impulses[] = {{"tap", 0.2f, 0}, {"hit", 0.5f, 40}, {"boom", 1.0f, 160}};
+
+    for(std::size_t i = 0; i < std::size(impulses); ++i)
+    {
+        Impulse const imp = impulses[i];
+        auto button = make_button({80.0f, 24.0f}, imp.name);
+        button->set_position({12.0f + 88.0f * static_cast<float>(i), 110.0f}, true);
+        button->set_callback([this, imp]() { impulse(imp.amount, imp.sparks); });
+        m_panel->add_widget(std::string("impulse_") + imp.name, button);
+    }
+
+    m_rumble = make_button({80.0f, 24.0f}, "rumble");
+    m_rumble->set_position({12.0f, 144.0f}, true);
+    m_panel->add_widget("rumble", m_rumble);
+
+    m_rumble_strength = std::make_shared<Slider>(sf::Vector2f{116.0f, 12.0f}, SKY);
+    m_rumble_strength->set_body_color(LINE);
+    m_rumble_strength->set_transition(TransitionFunction::None);
+    m_rumble_strength->set_position({102.0f, 150.0f}, true);
+    m_rumble_strength->set_percentage(0.35f);
+    m_panel->add_widget("rumble_strength", m_rumble_strength);
+
+    m_rumble_label = make_label({44.0f, 24.0f}, "", TEXT, Alignment::RIGHT);
+    m_rumble_label->set_position({PANEL_W - 56.0f, 144.0f}, true);
+    m_panel->add_widget("rumble_label", m_rumble_label);
+
+    m_hud_toggle = make_button({124.0f, 24.0f}, "");
+    m_hud_toggle->set_position({12.0f, 186.0f}, true);
+    m_hud_toggle->set_callback([this]() { set_hud_shakes(!m_hud_shakes); });
+    m_panel->add_widget("hud_toggle", m_hud_toggle);
+
+    m_roll_toggle = make_button({124.0f, 24.0f}, "");
+    m_roll_toggle->set_position({PANEL_W - 136.0f, 186.0f}, true);
+    m_roll_toggle->set_callback([this]() { set_roll(!m_roll); });
+    m_panel->add_widget("roll_toggle", m_roll_toggle);
+
+    set_hud_shakes(true);
+    set_roll(false);
+}
+
+float ShakeScene::rumble_amount() const
+{
+    return m_rumble_strength->get_value(RUMBLE_MIN, RUMBLE_MAX);
+}
+
+void ShakeScene::impulse(float amount, int sparks)
+{
+    m_camera.shake(amount);
+
+    if(sparks <= 0 || m_roofs.empty()) return;
+
+    // Something on the skyline takes the hit.
+    Roof const& roof = Random::pick(m_roofs);
+    sf::Vector2f const at{Random::real(roof.left + 6.0f, roof.right - 6.0f), roof.y};
+
+    m_sparks->set_position(at);
+    for(int i = 0; i < sparks; ++i)
+    {
+        sf::Color const color = Random::chance(0.7f) ? AMBER : CORAL;
+        m_sparks->add_particles_varied(1, color, Vector{90.0f + amount * 140.0f,
+                                       sf::degrees(90.0f)}, 70.0f, 60.0f);
+    }
+}
+
+void ShakeScene::set_hud_shakes(bool on)
+{
+    m_hud_shakes = on;
+    m_hud_toggle->add_text(on ? "hud  shakes" : "hud  steady", *font(), TEXT);
+}
+
+void ShakeScene::set_roll(bool on)
+{
+    m_roll = on;
+    m_camera.set_shake_roll_enabled(on);
+    m_roll_toggle->add_text(on ? "roll  on" : "roll  off", *font(), on ? TEXT : TEXT_DIM);
+}
+
+void ShakeScene::on_enter()
+{
+    DemoScene::on_enter();
+
+    m_camera.clear_shake();
+    m_sparks->clear();
+    m_trauma_history.assign(HISTORY, 0.0f);
+    m_floor_history.assign(HISTORY, 0.0f);
+    m_space_held = false;
+
+    sf::Vector2f const home{VIEW_W - PANEL_W - 24.0f, 20.0f};
+    m_panel->set_position(home + sf::Vector2f{PANEL_W + 40.0f, 0.0f}, true);
+    m_panel->set_position(home);
+}
+
+void ShakeScene::handle_event(const sf::Event& event, sf::Vector2f mouse_pos)
+{
+    DemoScene::handle_event(event, mouse_pos);
+
+    if(const auto* key = event.getIf<sf::Event::KeyPressed>())
+    {
+        switch(key->code)
+        {
+            case sf::Keyboard::Key::Num1:  impulse(0.2f, 0);   break;
+            case sf::Keyboard::Key::Num2:  impulse(0.5f, 40);  break;
+            case sf::Keyboard::Key::Num3:  impulse(1.0f, 160); break;
+            case sf::Keyboard::Key::Space: m_space_held = true; break;
+            default: break;
+        }
+    }
+    else if(const auto* released = event.getIf<sf::Event::KeyReleased>())
+    {
+        if(released->code == sf::Keyboard::Key::Space) m_space_held = false;
+    }
+}
+
+void ShakeScene::update(sf::Time delta_time)
+{
+    DemoScene::update(delta_time);
+
+    // A sustained floor only holds while it keeps being asked for.
+    if(m_rumble->is_pressed() || m_space_held)
+        m_camera.set_sustained_shake(rumble_amount());
+
+    m_camera.update(delta_time);
+    m_particles.update(delta_time);
+
+    float const trauma = std::min(1.0f, m_camera.get_trauma() + m_camera.get_sustained_shake());
+    m_gauge->set_value(trauma);
+
+    m_trauma_history.push_back(trauma);
+    m_floor_history.push_back(m_camera.get_sustained_shake());
+    while(m_trauma_history.size() > HISTORY) m_trauma_history.pop_front();
+    while(m_floor_history.size()  > HISTORY) m_floor_history.pop_front();
+    rebuild_graph();
+
+    char buffer[16];
+    std::snprintf(buffer, sizeof(buffer), "%.2f", static_cast<double>(rumble_amount()));
+    m_rumble_label->set_string(buffer);
+
+    std::snprintf(buffer, sizeof(buffer), "%.2f", static_cast<double>(trauma));
+    m_gauge_value->set_string(buffer);
+    m_gauge_value->set_text_color(trauma > 0.005f ? AMBER : TEXT_DIM);
+}
+
+void ShakeScene::rebuild_graph()
+{
+    m_graph.clear();
+
+    sf::Vector2f const origin = floor_vector(m_panel->get_position()) + GRAPH_POS;
+    push_rect(m_graph, {origin, GRAPH_SIZE}, INK);
+
+    // Gridlines at a quarter, half and three quarters.
+    for(float q : {0.25f, 0.5f, 0.75f})
+    {
+        float const y = std::floor(origin.y + GRAPH_SIZE.y * (1.0f - q));
+        push_rect(m_graph, {{origin.x, y}, {GRAPH_SIZE.x, 1.0f}}, fade(LINE, 0.5f));
+    }
+
+    // One column per sample: the floor as a filled band, trauma as a
+    // 2px line above it.
+    for(std::size_t i = 0; i < m_trauma_history.size(); ++i)
+    {
+        float const x  = origin.x + static_cast<float>(i);
+        float const fh = std::round(m_floor_history[i] * (GRAPH_SIZE.y - 2.0f));
+        float const th = std::round(m_trauma_history[i] * (GRAPH_SIZE.y - 2.0f));
+        float const bottom = origin.y + GRAPH_SIZE.y;
+
+        if(fh > 0.0f)
+            push_rect(m_graph, {{x, bottom - fh}, {1.0f, fh}}, fade(SKY, 0.45f));
+
+        push_rect(m_graph, {{x, bottom - th - 2.0f}, {1.0f, 2.0f}}, AMBER);
+    }
+}
+
+void ShakeScene::render(sf::RenderTarget& target)
+{
+    // World: pans and shakes.
+    target.setView(m_camera.get_view());
+    target.draw(m_world);
+    target.draw(m_moon);
+
+    sf::RenderStates additive;
+    additive.blendMode = sf::BlendAdd;
+    target.draw(m_particles, additive);
+
+    // Panel: either joins the shake or ignores it entirely.
+    target.setView(m_hud_shakes ? m_camera.get_ui_view() : target.getDefaultView());
+    target.draw(m_widgets);
+    target.draw(m_graph);
+}
+
+}
diff --git a/examples/showcase/ShakeScene.hpp b/examples/showcase/ShakeScene.hpp
new file mode 100644
index 0000000..2d001f2
--- /dev/null
+++ b/examples/showcase/ShakeScene.hpp
@@ -0,0 +1,85 @@
+/**
+ * ShakeScene.hpp  -  Showcase
+ *
+ * A small night skyline under a Camera, and a panel for shaking it.
+ *
+ * Impulses (tap, hit, boom) add trauma that decays on its own; holding
+ * rumble sets a sustained floor that impulses spike above and settle
+ * back to. A Gauge and a scrolling graph show the trauma as it happens.
+ *
+ * The panel can be drawn through the camera's UI view, so it jolts with
+ * the world, or through the default view, so it stays perfectly still.
+ */
+
+#ifndef SHOWCASE_SHAKE_SCENE_HPP
+#define SHOWCASE_SHAKE_SCENE_HPP
+
+#include "../../include/framework/Camera.hpp"
+#include "../../include/framework/ParticleSystemManager.hpp"
+#include "../../include/gui/Frame.hpp"
+#include "../../include/gui/Gauge.hpp"
+#include "../../include/gui/Slider.hpp"
+
+#include "DemoScene.hpp"
+
+#include <deque>
+
+namespace showcase
+{
+
+class ShakeScene : public DemoScene
+{
+private:
+    struct Roof
+    {
+        float left;
+        float right;
+        float y;
+    };
+
+    Camera                m_camera;
+    ParticleSystemManager m_particles;
+    std::shared_ptr<ParticleSystem> m_sparks;
+
+    sf::VertexArray   m_world{sf::PrimitiveType::Triangles};
+    sf::CircleShape   m_moon;
+    std::vector<Roof> m_roofs;
+
+    std::shared_ptr<Frame>   m_panel;
+    std::shared_ptr<Gauge>   m_gauge;
+    std::shared_ptr<TextBox> m_gauge_value;
+    std::shared_ptr<Button>  m_rumble;
+    std::shared_ptr<Slider>  m_rumble_strength;
+    std::shared_ptr<TextBox> m_rumble_label;
+    std::shared_ptr<Button>  m_hud_toggle;
+    std::shared_ptr<Button>  m_roll_toggle;
+
+    std::deque<float> m_trauma_history;
+    std::deque<float> m_floor_history;
+    sf::VertexArray   m_graph{sf::PrimitiveType::Triangles};
+
+    bool m_hud_shakes{true};
+    bool m_roll{false};
+    bool m_space_held{false};
+
+    void build_world();
+    void build_panel();
+    void impulse(float amount, int sparks);
+    void set_hud_shakes(bool on);
+    void set_roll(bool on);
+    void rebuild_graph();
+
+    [[nodiscard]] float rumble_amount() const;
+
+public:
+    ShakeScene();
+
+    void on_enter() override;
+    void handle_event(const sf::Event& event, sf::Vector2f mouse_pos) override;
+    void update(sf::Time delta_time) override;
+    void render(sf::RenderTarget& target) override;
+};
+
+}
+
+#endif
diff --git a/examples/showcase/Theme.hpp b/examples/showcase/Theme.hpp
new file mode 100644
index 0000000..2664b51
--- /dev/null
+++ b/examples/showcase/Theme.hpp
@@ -0,0 +1,147 @@
+/**
+ * Theme.hpp  -  Showcase
+ *
+ * Palette, font and a few widget helpers shared by every demo, so the
+ * scenes themselves only describe what is on screen.
+ *
+ * The font is Pixel Operator (CC0). It is drawn on a 16px grid, so text
+ * stays crisp at 16 and 32 and nowhere in between.
+ */
+
+#ifndef SHOWCASE_THEME_HPP
+#define SHOWCASE_THEME_HPP
+
+#include "../../include/gui/Button.hpp"
+#include "../../include/gui/Frame.hpp"
+#include "../../include/gui/TextBox.hpp"
+
+namespace showcase
+{
+
+// --------------------------------------------------------------- palette
+
+inline const sf::Color INK      {21, 19, 26};      // background
+inline const sf::Color PANEL    {32, 29, 38};
+inline const sf::Color PANEL_HI {46, 42, 54};
+inline const sf::Color LINE     {68, 62, 78};
+inline const sf::Color TEXT     {214, 203, 182};   // kept under the bloom threshold
+inline const sf::Color TEXT_DIM {128, 118, 120};
+
+inline const sf::Color AMBER    {240, 170, 78};
+inline const sf::Color CORAL    {222, 106, 88};
+inline const sf::Color SAGE     {132, 180, 140};
+inline const sf::Color SKY      {112, 162, 204};
+inline const sf::Color ROSE     {206, 128, 164};
+
+inline constexpr float VIEW_W = static_cast<float>(WINDOW_WIDTH);
+inline constexpr float VIEW_H = static_cast<float>(WINDOW_HEIGHT);
+
+inline constexpr unsigned TEXT_SIZE  = 16;
+inline constexpr unsigned TITLE_SIZE = 32;
+
+// ---------------------------------------------------------------- assets
+
+inline const sf::Font* font()
+{
+    return Assets::font("assets/fonts/pixel-font-bitmap.ttf");
+}
+
+// --------------------------------------------------------------- helpers
+
+/*
+ * A line of text in a transparent box.
+ */
+inline std::shared_ptr<TextBox> make_label(sf::Vector2f size, const std::string& text,
+                                           sf::Color color = TEXT,
+                                           Alignment alignment = Alignment::LEFT,
+                                           unsigned character_size = TEXT_SIZE)
+{
+    auto label = std::make_shared<TextBox>(size, sf::Color::Transparent, text,
+                                           *font(), color);
+    label->set_character_size(character_size);
+    label->set_alignment(alignment);
+    label->set_transition(TransitionFunction::None);
+    return label;
+}
+
+/*
+ * A flat button that brightens on hover and darkens when pressed.
+ */
+inline std::shared_ptr<Button> make_button(sf::Vector2f size, const std::string& text,
+                                           sf::Color color = PANEL_HI,
+                                           sf::Color text_color = TEXT)
+{
+    auto button = std::make_shared<Button>(size, color);
+    button->add_text(text, *font(), text_color);
+    button->set_character_size(TEXT_SIZE);
+    button->set_state_tints(-16, 12);
+    button->set_transition(TransitionFunction::None);
+    return button;
+}
+
+/*
+ * Title bar for every window in the showcase: the panel colour one
+ * step up, dim text, and a close button that only shows itself on hover.
+ */
+inline TaskbarStyle taskbar_style()
+{
+    TaskbarStyle style;
+    style.color            = PANEL_HI;
+    style.text_color       = TEXT_DIM;
+    style.close_color      = PANEL_HI;
+    style.close_text_color = TEXT_DIM;
+    style.close_label      = "x";
+    style.character_size   = TEXT_SIZE;
+    style.title_alignment  = Alignment::LEFT;
+    return style;
+}
+
+/*
+ * Recolours a button and rebuilds its hover and press tints, which
+ * Button otherwise derives once from its constructor colour.
+ */
+inline void recolor(Button& button, sf::Color color)
+{
+    button.set_color(color);
+    button.set_state_tints(-16, 12);
+}
+
+/*
+ * Same colour, scaled alpha.
+ */
+inline sf::Color fade(sf::Color color, float alpha)
+{
+    color.a = static_cast<std::uint8_t>(std::clamp(alpha, 0.0f, 1.0f) * color.a);
+    return color;
+}
+
+/*
+ * Linear blend, t = 0 gives a, t = 1 gives b.
+ */
+inline sf::Color mix(sf::Color a, sf::Color b, float t)
+{
+    auto lerp = [t](std::uint8_t x, std::uint8_t y)
+    {
+        return static_cast<std::uint8_t>(static_cast<float>(x) +
+                                         (static_cast<float>(y) - static_cast<float>(x)) * t);
+    };
+    return {lerp(a.r, b.r), lerp(a.g, b.g), lerp(a.b, b.b), lerp(a.a, b.a)};
+}
+
+/*
+ * Appends an axis-aligned rectangle to a Triangles vertex array.
+ */
+inline void push_rect(sf::VertexArray& vertices, sf::FloatRect rect, sf::Color color)
+{
+    sf::Vector2f const a = rect.position;
+    sf::Vector2f const b = {rect.position.x + rect.size.x, rect.position.y};
+    sf::Vector2f const c = rect.position + rect.size;
+    sf::Vector2f const d = {rect.position.x, rect.position.y + rect.size.y};
+
+    for(sf::Vector2f p : {a, b, c, a, c, d})
+        vertices.append(sf::Vertex{p, color});
+}
+
+}
+
+#endif

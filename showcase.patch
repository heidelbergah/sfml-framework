diff --git a/shaders/showcase/crt.frag b/shaders/showcase/crt.frag
new file mode 100644
index 0000000..57ed70c
--- /dev/null
+++ b/shaders/showcase/crt.frag
@@ -0,0 +1,60 @@
+// crt.frag  -  Showcase
+//
+// An old television over a tiny scene drawn at quarter resolution:
+// barrel distortion, alternate dark scanlines, a faint aperture-grille
+// tint, a vignette, and static while the channel changes.
+//
+// This one deliberately does not quantise to the palette. Scanlines and
+// static are the point, and they need the in-between shades.
+
+uniform vec2      resolution;
+uniform sampler2D screen;
+uniform float     time;
+uniform float     static_amount;
+uniform vec4      bezel;
+
+// Hash without sine (Dave Hoskins). The usual fract(sin(x) * 43758.5)
+// loses precision on many GPUs once x grows, and the "noise" turns into
+// visible stripes.
+float hash(vec2 p)
+{
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+void main()
+{
+    vec2 uv    = gl_TexCoord[0].xy;
+    vec2 pixel = floor(uv * resolution);
+
+    // Bulge outward from the centre.
+    vec2 c = uv * 2.0 - 1.0;
+    c *= 1.0 + dot(c, c) * 0.07;
+    vec2 tube = c * 0.5 + 0.5;
+
+    if(tube.x < 0.0 || tube.x > 1.0 || tube.y < 0.0 || tube.y > 1.0)
+    {
+        gl_FragColor = bezel;
+        return;
+    }
+
+    vec3 color = texture2D(screen, vec2(tube.x, 1.0 - tube.y)).rgb;
+
+    // Every other row dark.
+    if(mod(pixel.y, 2.0) > 0.5) color *= 0.55;
+
+    // Columns cycle through slight red, green and blue emphasis.
+    float column = mod(pixel.x, 3.0);
+    if(column < 0.5)      color *= vec3(1.06, 0.94, 0.94);
+    else if(column < 1.5) color *= vec3(0.94, 1.06, 0.94);
+    else                  color *= vec3(0.94, 0.94, 1.06);
+
+    color *= 1.0 - dot(c, c) * 0.22;
+    color *= 0.97 + 0.03 * sin(time * 50.0);
+
+    float noise = hash(pixel + vec2(time * 97.0, time * 13.0));
+    color = mix(color, vec3(noise * 0.85), static_amount);
+
+    gl_FragColor = vec4(color, 1.0);
+}
diff --git a/shaders/showcase/fire_shade.frag b/shaders/showcase/fire_shade.frag
new file mode 100644
index 0000000..9058557
--- /dev/null
+++ b/shaders/showcase/fire_shade.frag
@@ -0,0 +1,56 @@
+// fire_shade.frag  -  Showcase
+//
+// Turns the fire's heat field into colour. The simulation runs at half
+// the window's resolution; sampling it without smoothing keeps each
+// heat cell a crisp 2x2 block, and the dither runs at full resolution
+// inside them.
+
+uniform vec2      resolution;
+uniform sampler2D heat;
+
+// --- palette ramp, shared by every showcase shader -------------------
+//
+// Four colours from dark to light. A value between two of them is
+// resolved with a 4x4 ordered (Bayer) dither instead of a blend, so the
+// output only ever contains these four colours: pixel art, not a
+// gradient.
+
+uniform vec4 c0;
+uniform vec4 c1;
+uniform vec4 c2;
+uniform vec4 c3;
+
+float bayer2(vec2 a)
+{
+    a = floor(a);
+    return fract(a.x / 2.0 + a.y * a.y * 0.75);
+}
+
+float bayer4(vec2 a)
+{
+    return bayer2(0.5 * a) * 0.25 + bayer2(a);
+}
+
+vec4 ramp(float value, vec2 pixel)
+{
+    float scaled = clamp(value, 0.0, 1.0) * 3.0;
+    float index  = floor(scaled);
+    if(fract(scaled) > bayer4(pixel)) index += 1.0;
+
+    if(index < 0.5) return c0;
+    if(index < 1.5) return c1;
+    if(index < 2.5) return c2;
+    return c3;
+}
+
+// ----------------------------------------------------------------------
+
+void main()
+{
+    vec2 uv    = gl_TexCoord[0].xy;
+    vec2 pixel = floor(uv * resolution);
+
+    float h = texture2D(heat, vec2(uv.x, 1.0 - uv.y)).r;
+
+    gl_FragColor = ramp(h * 0.97, pixel);
+}
diff --git a/shaders/showcase/fire_step.frag b/shaders/showcase/fire_step.frag
new file mode 100644
index 0000000..4a49d40
--- /dev/null
+++ b/shaders/showcase/fire_step.frag
@@ -0,0 +1,93 @@
+// fire_step.frag  -  Showcase
+//
+// One step of the fire simulation, run into a render texture that is
+// read back on the next frame: the shader feeds itself.
+//
+// Each pixel takes the heat of the pixel just below it, its row nudged
+// left or right as a whole, and loses a random amount. The bottom row is kept hot,
+// so heat keeps rising and cooling into flames.
+//
+// Render textures are stored upside down, which is why every read flips
+// y. Reads and writes agree, so "below" stays below.
+
+uniform vec2      resolution;
+uniform sampler2D previous;
+uniform float     seed;
+uniform float     step;        // counts simulation steps
+uniform vec2      fan_pos;     // 0-1, in the window
+uniform float     fan;         // 0 when the mouse is elsewhere
+
+// Hash without sine (Dave Hoskins). The usual fract(sin(x) * 43758.5)
+// loses precision on many GPUs once x grows, and the "noise" turns into
+// visible stripes.
+float hash(vec2 p)
+{
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+// Smooth value noise: random values on a grid, blended between.
+float value_noise(vec2 p)
+{
+    vec2 cell = floor(p);
+    vec2 f    = fract(p);
+    f = f * f * (3.0 - 2.0 * f);
+
+    float a = hash(cell);
+    float b = hash(cell + vec2(1.0, 0.0));
+    float c = hash(cell + vec2(0.0, 1.0));
+    float d = hash(cell + vec2(1.0, 1.0));
+    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
+}
+
+float heat_at(vec2 pixel)
+{
+    vec2 uv = (pixel + 0.5) / resolution;
+    return texture2D(previous, vec2(uv.x, 1.0 - uv.y)).r;
+}
+
+void main()
+{
+    vec2 pixel = floor(gl_TexCoord[0].xy * resolution);
+
+    float r = hash(pixel + vec2(seed * 61.0, seed * 17.0));
+
+    float heat;
+    if(pixel.y >= resolution.y - 1.0)
+    {
+        // A steady source. Each row above is effectively an older copy
+        // of this one, so a source that changed every step would paint
+        // a different stripe into every row; the flames come from the
+        // uneven cooling instead.
+        heat = 1.0;
+    }
+    else
+    {
+        // Drift sideways a whole row at a time, like wind. Choosing it
+        // per pixel made neighbours read the same pixel below, so their
+        // histories merged and smeared the heat into horizontal streaks.
+        float gust  = hash(vec2(pixel.y * 1.7, seed * 13.0));
+        float drift = floor(gust * 3.0) - 1.0;
+        heat = heat_at(pixel + vec2(drift, 1.0));
+
+        // Cooling comes mostly from a smooth noise field that rises at
+        // the same speed as the heat (one row per step), so a column of
+        // flame keeps meeting the same patch of it: columns in a cool
+        // patch die early, their neighbours shoot up, and you get
+        // tongues. Independent per-pixel cooling just averages out into
+        // a noisy gradient.
+        float field = value_noise(vec2(pixel.x / 4.5, (pixel.y + step) / 11.0));
+        heat -= 0.010 + field * field * 0.075 + r * 0.008;
+    }
+
+    // The mouse adds a blob of heat while it is over the window.
+    if(fan > 0.0)
+    {
+        float d = distance(pixel, fan_pos * resolution);
+        heat = max(heat, fan * (1.0 - smoothstep(2.0, 7.0, d)));
+    }
+
+    heat = clamp(heat, 0.0, 1.0);
+    gl_FragColor = vec4(heat, heat, heat, 1.0);
+}
diff --git a/shaders/showcase/plasma.frag b/shaders/showcase/plasma.frag
new file mode 100644
index 0000000..d82afa7
--- /dev/null
+++ b/shaders/showcase/plasma.frag
@@ -0,0 +1,62 @@
+// plasma.frag  -  Showcase
+//
+// The classic demoscene plasma: a few overlapping sine fields summed and
+// mapped through the palette. Everything comes from time and position;
+// no texture is read. The swirl's centre follows the mouse while the
+// window is hovered.
+
+uniform vec2  resolution;
+uniform float time;
+uniform vec2  center;      // 0-1, in the window
+
+// --- palette ramp, shared by every showcase shader -------------------
+//
+// Four colours from dark to light. A value between two of them is
+// resolved with a 4x4 ordered (Bayer) dither instead of a blend, so the
+// output only ever contains these four colours: pixel art, not a
+// gradient.
+
+uniform vec4 c0;
+uniform vec4 c1;
+uniform vec4 c2;
+uniform vec4 c3;
+
+float bayer2(vec2 a)
+{
+    a = floor(a);
+    return fract(a.x / 2.0 + a.y * a.y * 0.75);
+}
+
+float bayer4(vec2 a)
+{
+    return bayer2(0.5 * a) * 0.25 + bayer2(a);
+}
+
+vec4 ramp(float value, vec2 pixel)
+{
+    float scaled = clamp(value, 0.0, 1.0) * 3.0;
+    float index  = floor(scaled);
+    if(fract(scaled) > bayer4(pixel)) index += 1.0;
+
+    if(index < 0.5) return c0;
+    if(index < 1.5) return c1;
+    if(index < 2.5) return c2;
+    return c3;
+}
+
+// ----------------------------------------------------------------------
+
+void main()
+{
+    vec2 uv    = gl_TexCoord[0].xy;
+    vec2 pixel = floor(uv * resolution);
+
+    vec2 p = (uv - center) * vec2(resolution.x / resolution.y, 1.0) * 9.0;
+
+    float v = sin(p.x * 0.9 + time);
+    v += sin((p.y * 0.7 + time) * 1.1);
+    v += sin((p.x + p.y) * 0.6 + time * 0.7);
+    v += sin(length(p) * 1.3 - time * 1.6);
+
+    gl_FragColor = ramp(v * 0.125 + 0.5, pixel);
+}
diff --git a/shaders/showcase/ripple.frag b/shaders/showcase/ripple.frag
new file mode 100644
index 0000000..bd99d62
--- /dev/null
+++ b/shaders/showcase/ripple.frag
@@ -0,0 +1,77 @@
+// ripple.frag  -  Showcase
+//
+// Shades a water surface. The wave simulation itself runs on the CPU and
+// arrives as a height texture; this pass works out the slope at each
+// pixel, bends the tiled floor underneath by it, and adds a glint where
+// the surface tilts toward the light.
+
+uniform vec2      resolution;
+uniform sampler2D heights;    // r = height, 0.5 is still water
+
+// --- palette ramp, shared by every showcase shader -------------------
+//
+// Four colours from dark to light. A value between two of them is
+// resolved with a 4x4 ordered (Bayer) dither instead of a blend, so the
+// output only ever contains these four colours: pixel art, not a
+// gradient.
+
+uniform vec4 c0;
+uniform vec4 c1;
+uniform vec4 c2;
+uniform vec4 c3;
+
+float bayer2(vec2 a)
+{
+    a = floor(a);
+    return fract(a.x / 2.0 + a.y * a.y * 0.75);
+}
+
+float bayer4(vec2 a)
+{
+    return bayer2(0.5 * a) * 0.25 + bayer2(a);
+}
+
+vec4 ramp(float value, vec2 pixel)
+{
+    float scaled = clamp(value, 0.0, 1.0) * 3.0;
+    float index  = floor(scaled);
+    if(fract(scaled) > bayer4(pixel)) index += 1.0;
+
+    if(index < 0.5) return c0;
+    if(index < 1.5) return c1;
+    if(index < 2.5) return c2;
+    return c3;
+}
+
+// ----------------------------------------------------------------------
+
+float height(vec2 uv)
+{
+    return texture2D(heights, uv).r * 2.0 - 1.0;
+}
+
+void main()
+{
+    vec2 uv    = gl_TexCoord[0].xy;
+    vec2 pixel = floor(uv * resolution);
+    vec2 texel = 1.0 / resolution;
+
+    float dx = height(uv + vec2(texel.x, 0.0)) - height(uv - vec2(texel.x, 0.0));
+    float dy = height(uv + vec2(0.0, texel.y)) - height(uv - vec2(0.0, texel.y));
+
+    // The floor, seen through the water: 16px tiles, displaced by slope.
+    vec2  seen  = pixel + vec2(dx, dy) * 24.0;
+    vec2  cell  = mod(seen, 16.0);
+    float grout = (cell.x < 1.0 || cell.y < 1.0) ? 1.0 : 0.0;
+    float check = mod(floor(seen.x / 16.0) + floor(seen.y / 16.0), 2.0);
+
+    // Still water sits exactly on the second colour, so only the
+    // ripples dither; tiles alternate faintly and grout drops a level.
+    float value = 0.334 + check * 0.05 - grout * 0.16;
+
+    // Light from the top left.
+    value += clamp(-(dx + dy) * 2.2, 0.0, 1.0) * 0.75;
+    value -= clamp((dx + dy) * 1.2, 0.0, 1.0) * 0.18;
+
+    gl_FragColor = ramp(value, pixel);
+}
diff --git a/shaders/showcase/scope.frag b/shaders/showcase/scope.frag
new file mode 100644
index 0000000..bd48ae4
--- /dev/null
+++ b/shaders/showcase/scope.frag
@@ -0,0 +1,78 @@
+// scope.frag  -  Showcase
+//
+// An oscilloscope trace. The latest audio arrives as a one-pixel-high
+// texture, one sample per column. Each pixel measures how far it is
+// from the line joining its column's sample to the next one, so the
+// trace is a continuous line however steep it gets, with a soft glow
+// around it.
+
+uniform vec2      resolution;
+uniform sampler2D samples;    // r = sample, 0.5 is silence
+uniform float     level;      // 0 hides the trace, 1 shows it fully
+
+// --- palette ramp, shared by every showcase shader -------------------
+//
+// Four colours from dark to light. A value between two of them is
+// resolved with a 4x4 ordered (Bayer) dither instead of a blend, so the
+// output only ever contains these four colours: pixel art, not a
+// gradient.
+
+uniform vec4 c0;
+uniform vec4 c1;
+uniform vec4 c2;
+uniform vec4 c3;
+
+float bayer2(vec2 a)
+{
+    a = floor(a);
+    return fract(a.x / 2.0 + a.y * a.y * 0.75);
+}
+
+float bayer4(vec2 a)
+{
+    return bayer2(0.5 * a) * 0.25 + bayer2(a);
+}
+
+vec4 ramp(float value, vec2 pixel)
+{
+    float scaled = clamp(value, 0.0, 1.0) * 3.0;
+    float index  = floor(scaled);
+    if(fract(scaled) > bayer4(pixel)) index += 1.0;
+
+    if(index < 0.5) return c0;
+    if(index < 1.5) return c1;
+    if(index < 2.5) return c2;
+    return c3;
+}
+
+// ----------------------------------------------------------------------
+
+float trace_y(float column)
+{
+    float s = texture2D(samples, vec2((column + 0.5) / resolution.x, 0.5)).r * 2.0 - 1.0;
+    return (0.5 - s * 0.9) * resolution.y;
+}
+
+void main()
+{
+    vec2 uv    = gl_TexCoord[0].xy;
+    vec2 pixel = floor(uv * resolution);
+
+    float a  = trace_y(pixel.x);
+    float b  = trace_y(min(pixel.x + 1.0, resolution.x - 1.0));
+    float lo = min(a, b) - 0.5;
+    float hi = max(a, b) + 0.5;
+
+    float y = pixel.y + 0.5;
+    float d = max(max(lo - y, y - hi), 0.0);
+
+    float line = (d < 1.0) ? 1.0 : exp(-(d - 1.0) * 0.45) * 0.55;
+    line *= level;
+
+    // A faint graticule: eight columns, four rows.
+    float gx   = mod(pixel.x, resolution.x / 8.0);
+    float gy   = mod(pixel.y, resolution.y / 4.0);
+    float grid = (gx < 1.0 || gy < 1.0) ? 0.2 : 0.0;
+
+    gl_FragColor = ramp(max(line, grid), pixel);
+}
